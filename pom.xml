<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.dongqiuxing</groupId>
    <artifactId>feedback-system</artifactId>
    <version>1.0.0</version>
    <name>feedback-system</name>
    <description>企业内部意见反馈系统 - Spring Boot + MyBatis-Plus + Redis + RabbitMQ + Thymeleaf</description>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf 模板引擎 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- MyBatis-Plus 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.5</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Boot AMQP (RabbitMQ) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Jackson JSON 序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Jackson JSR310：支持 Java 8 LocalDateTime 等时间类型序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试依赖
            spring-boot-starter-test 里已包含 JUnit 5(Jupiter)、Mockito、AssertJ、
            JsonPath、MockMvc(spring-test)，无需再单独引。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 内存数据库（仅测试）
            集成测试用它替代 MySQL，好处是 mvn test 在任何机器上都能直接跑通，
            不需要先装好并启动 MySQL/Redis/RabbitMQ。测试库结构与 MySQL 保持一致。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        必须显式引用 ${argLine}，否则 Spring Boot 父 POM 里 surefire
                        自带的 argLine 会把 JaCoCo 注入的 -javaagent 参数覆盖掉，
                        结果探针没有织入、jacoco.exec 不生成、覆盖率报告被跳过。
                    -->
                    <argLine>${argLine} -Dfile.encoding=${project.build.sourceEncoding}</argLine>
                </configuration>
            </plugin>

            <!--
                JaCoCo 覆盖率插件
                mvn test 时会自动织入探针，并在 target/site/jacoco/index.html 生成覆盖率报告，
                用来量化「测试到底覆盖了多少代码」，而不是只数用例条数。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <excludes>
                        <!--
                            Spring Boot 启动类的 main 方法在自动化测试中不会被调用，
                            计入覆盖率只会无意义地拉低分母，这里排除。
                            业务类、配置类一律保留在统计范围内，不做美化。
                        -->
                        <exclude>**/FeedbackApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!--
                                探针数据默认写到 target/jacoco.exec。
                                但 surefire 在 Windows 下是用 cmd.exe 拼分叉命令行的，
                                当项目路径含非 ASCII 字符（例如 D:\作业\...）时，argLine 里的
                                中文路径会被按系统编码转换、变成乱码目录，探针写不进去，
                                jacoco.exec 永远不会生成，覆盖率报告被静默跳过。
                                改写到系统临时目录（纯 ASCII）即可稳定生成，与项目位置无关。
                            -->
                            <destFile>${java.io.tmpdir}/jacoco-feedback.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${java.io.tmpdir}/jacoco-feedback.exec</dataFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
